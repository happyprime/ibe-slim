{
	"name": "@happyprime/ibe-slim",
	"version": "3.1.0",
	"description": "A single-purpose fork of @automattic/isolated-block-editor. Unsupported.",
	"author": "Happy Prime",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress"
	],
	"homepage": "https://github.com/happyprime/ibe-slim/blob/trunk/README.md",
	"repository": {
		"type": "git",
		"url": "https://github.com/happyprime/ibe-slim.git"
	},
	"bugs": {
		"url": "https://github.com/happyprime/ibe-slim/issues"
	},
	"engines": {
		"node": ">=20"
	},
	"main": "build/index.js",
	"sideEffects": [
		"*.css",
		"*.scss"
	],
	"dependencies": {
		"@babel/runtime": "^7.26.10",
		"@wordpress/base-styles": "^10.0.1",
		"@wordpress/icons": "^14.0.1",
		"@wordpress/interface": "9.4.0",
		"classnames": "^2.5.1",
		"redux-undo": "^1.1.0"
	},
	"devDependencies": {
		"@babel/cli": "^7.26.4",
		"@babel/core": "^7.26.10",
		"@babel/plugin-transform-runtime": "^7.26.10",
		"@babel/preset-env": "^7.26.9",
		"@babel/preset-react": "^7.26.3",
		"@happyprime/eslint-config": "^1.0.0",
		"@wordpress/babel-preset-default": "^8.48.1",
		"@wordpress/npm-package-json-lint-config": "^5.10.0",
		"npm-package-json-lint": "^8.0.0"
	},
	"scripts": {
		"build": "BUILD_ENV=cjs babel src --out-dir build --source-maps --ignore 'src/**/__tests__/*.js' --copy-files --no-copy-ignored && rm -rf build/browser",
		"clean": "rm -rf build",
		"lint": "npm run lint:js",
		"lint:fix": "eslint . --fix",
		"lint:js": "eslint .",
		"lint:package": "node ./node_modules/npm-package-json-lint/dist/cli.js ./package.json"
	},
	"npmpackagejsonlint": {
		"extends": "@wordpress/npm-package-json-lint-config"
	}
}
